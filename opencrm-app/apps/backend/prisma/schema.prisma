// =============================================================
// OpenCRM — Prisma Schema (Phase 3)
//
// Aligned to builder-class contract (database/ERD.md Auth & Tenant).
// Preserves Phase 2 CRM entities + adds Better Auth tables,
// organization/member/invitation, and apps (multi-tenant root).
//
// Run order after changes:
//   bun run db:push       — apply schema to database (dev)
//   bun run db:generate   — regenerate Prisma client
// =============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// APPS — Multi-tenant root
// Every tenant has one `apps` row. Most business tables carry
// app_id as FK for data isolation.
// =============================================================
model App {
  id              String    @id @default(cuid())
  appId           String    @unique @map("app_id")
  appSecretHash   String?   @map("app_secret_hash")
  appName         String?   @map("app_name")
  description     String?
  isActive        Boolean   @default(true) @map("is_active")
  allowedOrigins  Json?     @map("allowed_origins")
  rateLimitPerMin Int?      @map("rate_limit_per_minute")
  lastUsedAt      DateTime? @map("last_used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization?
  users        User[]
  teams        Team[]
  customers    Customer[]
  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]

  @@map("apps")
}

// =============================================================
// USERS — Better Auth compatible
// Fields aligned to builder ERD: emailVerified, password, role,
// avatar_url, account_id, app_id, etc.
// =============================================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false) @map("email_verified")
  password      String?
  role          String?   @default("agent")
  avatarUrl     String?   @map("avatar_url")
  active        Boolean?  @default(true)
  phoneNumber   String?   @map("phone_number")
  timezone      String?
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Multi-tenant link
  appId String? @map("app_id")
  app   App?    @relation(fields: [appId], references: [id], onDelete: SetNull)

  // Team membership
  teamId String? @map("team_id")
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // Organization relations
  members     Member[]
  invitations Invitation[] @relation("InviterUser")

  // CRM relations
  assignedDeals Deal[]     @relation("DealAssignee")
  activities    Activity[] @relation("ActivityPerformer")

  @@index([appId])
  @@index([teamId])
  @@map("users")
}

// =============================================================
// SESSION — Better Auth session table
// =============================================================
model Session {
  id                     String   @id @default(cuid())
  expiresAt              DateTime @map("expires_at")
  token                  String   @unique
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  ipAddress              String?  @map("ip_address")
  userAgent              String?  @map("user_agent")
  activeOrganizationId   String?  @map("active_organization_id")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("session")
}

// =============================================================
// ACCOUNT — Better Auth OAuth/provider account table
// =============================================================
model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

// =============================================================
// VERIFICATION — Better Auth email/token verification
// =============================================================
model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verification")
}

// =============================================================
// ORGANIZATION — tenant workspace
// Each org links to one App for multi-tenant scoping.
// =============================================================
model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?
  description String?
  createdBy   String?   @map("created_by")
  metadata    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Link to apps table for multi-tenant data scoping
  appId String? @unique @map("app_id")
  app   App?    @relation(fields: [appId], references: [id], onDelete: SetNull)

  members     Member[]
  invitations Invitation[]

  @@map("organization")
}

// =============================================================
// MEMBER — organization membership (user <-> org)
// =============================================================
model Member {
  id        String   @id @default(cuid())
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

// =============================================================
// INVITATION — org invite (pending/accepted/rejected)
// =============================================================
model Invitation {
  id        String   @id @default(cuid())
  email     String
  role      String   @default("member")
  status    String   @default("pending")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  inviterId String @map("inviter_id")
  inviter   User   @relation("InviterUser", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// =============================================================
// TEAMS
// =============================================================
model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  appId String? @map("app_id")
  app   App?    @relation(fields: [appId], references: [id], onDelete: SetNull)

  users User[]

  @@index([appId])
  @@map("teams")
}

// =============================================================
// CUSTOMERS
// =============================================================
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  industry  String?
  website   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appId String? @map("app_id")
  app   App?    @relation(fields: [appId], references: [id], onDelete: SetNull)

  contacts   Contact[]
  deals      Deal[]
  activities Activity[] @relation("ActivityCustomer")

  @@index([appId])
  @@map("customers")
}

// =============================================================
// CONTACTS
// =============================================================
model Contact {
  id        String   @id @default(cuid())
  firstName String   @map("first_name")
  lastName  String?  @map("last_name")
  email     String?
  phone     String?
  jobTitle  String?  @map("job_title")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  appId String? @map("app_id")
  app   App?    @relation(fields: [appId], references: [id], onDelete: SetNull)

  activities Activity[] @relation("ActivityContact")

  @@index([customerId])
  @@index([appId])
  @@map("contacts")
}

// =============================================================
// DEALS
// =============================================================
model Deal {
  id                String    @id @default(cuid())
  title             String
  value             Decimal?  @db.Decimal(12, 2)
  currency          String    @default("USD")
  stage             String    @default("lead")
  priority          String    @default("medium")
  expectedCloseDate DateTime? @map("expected_close_date")
  closedAt          DateTime? @map("closed_at")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assigneeId String? @map("assignee_id")
  assignee   User?   @relation("DealAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  appId String? @map("app_id")
  app   App?    @relation(fields: [appId], references: [id], onDelete: SetNull)

  activities Activity[] @relation("ActivityDeal")

  @@index([customerId])
  @@index([assigneeId])
  @@index([appId])
  @@index([stage])
  @@map("deals")
}

// =============================================================
// ACTIVITIES
// =============================================================
model Activity {
  id          String    @id @default(cuid())
  type        String
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  performedById String? @map("performed_by_id")
  performedBy   User?   @relation("ActivityPerformer", fields: [performedById], references: [id], onDelete: SetNull)

  customerId String?   @map("customer_id")
  customer   Customer? @relation("ActivityCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  contactId String?  @map("contact_id")
  contact   Contact? @relation("ActivityContact", fields: [contactId], references: [id], onDelete: SetNull)

  dealId String? @map("deal_id")
  deal   Deal?   @relation("ActivityDeal", fields: [dealId], references: [id], onDelete: SetNull)

  appId String? @map("app_id")
  app   App?    @relation(fields: [appId], references: [id], onDelete: SetNull)

  @@index([performedById])
  @@index([customerId])
  @@index([contactId])
  @@index([dealId])
  @@index([appId])
  @@map("activities")
}
