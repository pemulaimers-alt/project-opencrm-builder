# ============================================================
# OpenCRM Frontend — Environment Variables
# Copy to .env and fill in values before running.
# All VITE_ variables are inlined at build time.
# ============================================================

# Backend API base URL
VITE_API_URL=http://localhost:3010

# Socket.IO server URL (Phase 6)
VITE_SOCKET_URL=http://localhost:3011
VITE_SOCKET_PATH=/socket.io

# App display name
VITE_APP_NAME=OpenCRM
